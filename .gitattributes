# Default: auto-detect text vs binary
* text=auto eol=lf

# Source / config (force LF on all platforms)
*.py        text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.txt       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.sh        text eol=lf

# Windows-only scripts
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary assets
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.pdf       binary
*.stl       binary
*.step      binary
*.ico       binary
